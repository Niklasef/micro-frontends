---
import "../styles/tailwind.css";
import Search from "../components/Search.astro";
export const title = "Welcome to asearch-component";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1 style="font-family: system-ui;">🚀 asearch-component</h1>
      <p>This is a bare-bones Astro project scaffolded alongside <code>nsearch-component</code>.</p>

      <!-- Interactive search feature ported from Next.js -->
      <Search />
    </main>
  </body>
</html>
