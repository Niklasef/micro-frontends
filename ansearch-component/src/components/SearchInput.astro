<!--
  A super-minimal Astro component that server-side renders a declarative
  Shadow DOM (DSD) for <search-input>. Browsers that support DSD will
  automatically attach the shadow-root. Others will be upgraded by the
  runtime in SearchInputElement.ts.
-->
<search-input>
  <template shadowrootmode="open">
    <input
      type="search"
      placeholder="Search..."
      class="border rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
  </template>
</search-input>
